{
  // A browser-only program over client faces (the vite app and the test
  // plane); extends the client base so its split-package reference below may
  // name connection's client leaf (project-reference-faces classifies by the
  // extends chain).
  "extends": "../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib/types",
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tests"
  ],
  "references": [
    {
      "path": "../../packages/client/web"
    },
    {
      "path": "../../packages/client/modules"
    },
    {
      "path": "../../packages/client/connection/tsconfig.client.json"
    }
  ]
}
